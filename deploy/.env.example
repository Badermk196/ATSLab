# Copy this file to ".env" next to it and fill it in:   cp .env.example .env
# ".env" holds real secrets: it must NEVER be committed, pushed or uploaded (it is already in .gitignore).

# 1. The address of the app. Use your own subdomain. The DNS record of this name must point to the server's IP.
DOMAIN=app.1000jobs.club
#    The email for the free HTTPS certificate notices (Let's Encrypt). Optional.
EMAIL=bader@1000jobs.club

# 2. The AI key (OpenRouter). Costs money per check: keep an eye on the balance.
OPENROUTER_API_KEY=sk-or-v1-...

# 3. The admin accounts of the Admin page: name -> password, as JSON. Use long passwords.
#    Example: {"Bader": "a-long-password", "Sara": "another-long-password"}
ATSLAB_ADMINS={"Bader": "change-me-please-123456"}

# 4. The links on the user page (optional here: an admin can also set them on the Admin page, Settings).
#    A calendar link (Calendly, Google Calendar appointment schedule, ...) goes in ATSLAB_BOOKING_URL.
ATSLAB_PREMIUM_URL=https://1000jobs.club
ATSLAB_BOOKING_URL=
ATSLAB_SITE_URL=https://1000jobs.club

# 5. Limits (optional): 3 free checks a day per person, files kept 30 days.
ATSLAB_DAILY_CHECKS=3
ATSLAB_FILE_DAYS=30
