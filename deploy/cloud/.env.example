# 1000Jobs ATS Lab - settings for the Manus Cloud Computer.
# Copy this file to .env and fill in the two required lines:
#   cp .env.example .env
#   nano .env
# .env is never committed and never goes into the Docker image.

# 1. REQUIRED. The AI key (OpenRouter), used for job keywords and the AI review.
OPENROUTER_API_KEY=sk-or-v1-...

# 2. REQUIRED. The admin accounts: name = "password", one per person.
#    The name is shown in the history as "Checked by". Use long passwords.
#    Example: {"Bader": "a-long-password", "Sara": "another-long-password"}
ATSLAB_ADMINS={"Bader": "change-me-please-123456"}

# 3. HTTPS mode only. Leave empty for the direct port mode.
#    Set DOMAIN to <public-ip-with-dashes>.sslip.io, for example 34-12-56-78.sslip.io
#    EMAIL is optional: Let's Encrypt uses it for certificate expiry notices.
DOMAIN=
EMAIL=

# 4. Links shown on the user page (an admin can also change them on the Admin page, Settings).
ATSLAB_PREMIUM_URL=https://1000jobs.club
ATSLAB_BOOKING_URL=
ATSLAB_SITE_URL=https://1000jobs.club

# 5. Limits (optional): 3 free checks a day per person, resume files kept 30 days.
ATSLAB_DAILY_CHECKS=3
ATSLAB_FILE_DAYS=30
