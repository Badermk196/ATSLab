# 1000Jobs ATS Lab - secrets. Copy this file to .streamlit/secrets.toml and fill it in.
# On Streamlit Cloud: paste the same lines into the app's "Secrets" box instead.
# Never share the real file and never put it in a code repository or a Docker image.

# The OpenRouter key for the AI parts (job keywords, the AI review)
OPENROUTER_API_KEY = "sk-or-v1-..."

# Optional settings: remove the # to use one. An admin can also change them on the Admin page (Settings).
# ATSLAB_FILE_DAYS = 30                      # days to keep uploaded resume files
# ATSLAB_PREMIUM_URL = "https://..."         # the "Get Premium" button
# ATSLAB_BOOKING_URL = "https://..."         # the "Book a resume session" button
# ATSLAB_COLLECT_LEADS = false               # ask for name and email before the result
# ATSLAB_DATA_DIR = "/data"                  # where the history database and resume files are kept

# Admin accounts for the /admin page: one line per person, name = "password".
# The name is shown in the history ("Checked by"). Use long passwords. Keep this part LAST in the file.
[admins]
Bader = "choose-a-long-password"
Sara = "another-long-password"
